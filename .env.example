# Required by scripts/data.py + scripts/ingest.py to pull 10-K filings via
# sec-api.io. Not needed at API/UI runtime -- only for (re)building chroma_db.
SEC_API_KEY=

# Optional: raises HuggingFace's anonymous rate limit when downloading the
# embedding model. Not required.
HF_TOKEN=

# "ollama" (default, local/private) or "groq" (hosted, used for the public
# demo since a public URL can't require visitors to run Ollama locally).
LLM_PROVIDER=ollama

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Only read when LLM_PROVIDER=groq. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

CHROMA_PATH=./chroma_db
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional -- only used by scripts/sync_chroma.py. If set, the container
# entrypoint pulls a pre-built chroma_db down from this S3 bucket/prefix on
# startup instead of relying on the image having it baked in.
CHROMA_S3_BUCKET=
CHROMA_S3_PREFIX=chroma_db
